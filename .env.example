# Version reported by GET /health (overrides the VERSION file; leave unset in AWS Fargate)
# APP_VERSION=

# Secret used to sign and validate the JWT (at least 32 characters)
JWT_SECRET_KEY=change-me-to-a-random-value-of-at-least-32-chars

# Local database (docker-compose). In AWS Fargate leave it unset: the task definition sets the RDS_* variables.
DATABASE_URL=postgresql://blacklist:blacklist@localhost:5432/blacklist

# RDS_HOSTNAME=
# RDS_PORT=5432
# RDS_DB_NAME=
# RDS_USERNAME=
# RDS_PASSWORD=

# Number of proxies in front of the app: 0 locally (no proxy), 1 in AWS Fargate (the load balancer)
PROXY_FIX_X_FOR=0
