# Version reported by GET /health (overrides the VERSION file; leave unset on Elastic Beanstalk)
# APP_VERSION=

# Secret used to sign and validate the JWT (at least 32 characters)
JWT_SECRET_KEY=change-me-to-a-random-value-of-at-least-32-chars

# Local database (docker-compose). On Elastic Beanstalk leave it unset and use the RDS_* variables.
DATABASE_URL=postgresql://blacklist:blacklist@localhost:5432/blacklist

# RDS_HOSTNAME=
# RDS_PORT=5432
# RDS_DB_NAME=
# RDS_USERNAME=
# RDS_PASSWORD=

# Number of proxies in front of the app (load balancer + nginx on Elastic Beanstalk)
PROXY_FIX_X_FOR=2
